{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env.local", ".env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "MINIO_ENDPOINT",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_REGION",
    "MINIO_BUCKET_PREFIX",
    "AUTH_SECRET",
    "ENCRYPTION_KEY",
    "LOGIFIT_DATA_KEY",
    "BREVO_SMTP_HOST",
    "BREVO_SMTP_PORT",
    "BREVO_SMTP_USER",
    "BREVO_SMTP_PASSWORD",
    "EMAIL_FROM",
    "EMAIL_FROM_NAME",
    "SMTP_HOST",
    "SMTP_PORT",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_ROOT_DOMAIN",
    "NEXT_PUBLIC_DEFAULT_LOCALE",
    "PRIVACY_EMAIL",
    "COMMERCIAL_EMAIL",
    "NODE_ENV",
    "GOOGLE_CLOUD_PROJECT",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "VERTEX_AI_LOCATION",
    "GROQ_API_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "GLITCHTIP_DSN",
    "SENTRY_AUTH_TOKEN",
    "LOKI_URL",
    "ASAAS_API_KEY",
    "ASAAS_ENV",
    "ASAAS_WEBHOOK_SECRET",
    "CNPJA_API_KEY",
    "OCRSPACE_API_KEY",
    "GOOGLE_VISION_API_KEY",
    "ARQUIVEI_API_ID",
    "ARQUIVEI_API_KEY",
    "FOCUS_NFE_TOKEN",
    "FOCUS_NFE_ENV",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_WHATSAPP_FROM",
    "GUPSHUP_API_KEY",
    "GUPSHUP_APP_ID",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET",
    "CLOUDFLARE_API_TOKEN",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_ENDPOINT",
    "BACKUP_GPG_RECIPIENT",
    "QR_HMAC_SECRET",
    "JWT_SECRET",
    "CRON_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:rls-check": {
      "cache": false
    },
    "i18n:check": {
      "cache": false
    }
  }
}
