{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema, migrations and RLS policies (Drizzle is the single source of truth — ADR 0004)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./policies": "./src/policies/index.ts",
    "./persons": "./src/persons/index.ts",
    "./agenda": "./src/agenda/index.ts",
    "./engajamento": "./src/engajamento/index.ts",
    "./treinos": "./src/treinos/index.ts",
    "./avaliacoes": "./src/avaliacoes/index.ts",
    "./mensagens": "./src/mensagens/index.ts",
    "./financeiro": "./src/financeiro/index.ts",
    "./erp-financeiro": "./src/erp-financeiro/index.ts",
    "./rateio": "./src/rateio/index.ts",
    "./bancos": "./src/bancos/index.ts",
    "./adquirencia": "./src/adquirencia/index.ts",
    "./retencao": "./src/retencao/index.ts",
    "./fisio": "./src/fisio/index.ts",
    "./evolucoes": "./src/evolucoes/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:vendas": "tsx scripts/seed-vendas.ts",
    "db:seed:treinos": "tsx scripts/seed-treinos.ts",
    "db:seed:avaliacoes": "tsx scripts/seed-avaliacoes.ts",
    "db:seed:mensagens": "tsx scripts/seed-mensagens.ts",
    "db:seed:custos": "tsx scripts/seed-custos.ts",
    "db:seed:plano-contas": "tsx scripts/seed-plano-contas.ts",
    "db:seed:erp-financeiro": "tsx scripts/seed-erp-financeiro.ts",
    "db:seed:rateio-ic": "tsx scripts/seed-rateio-ic.ts",
    "db:seed:bancos": "tsx scripts/seed-bancos.ts",
    "db:seed:adquirencia": "tsx scripts/seed-adquirencia.ts",
    "db:seed:retencao": "tsx scripts/seed-retencao.ts",
    "db:seed:fisio": "tsx scripts/seed-fisio.ts",
    "db:seed:evolucoes": "tsx scripts/seed-evolucoes.ts",
    "db:rls-check": "tsx tests/rls-check.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "rrule": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
